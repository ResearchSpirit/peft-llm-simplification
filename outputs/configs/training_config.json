{
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.0,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "max_seq_length": 512,
  "num_epochs": 2,
  "max_steps": -1,
  "learning_rate": 0.0002,
  "per_device_train_batch_size": 2,
  "gradient_accumulation_steps": 4,
  "effective_batch_size": 8,
  "optimizer": "adamw_8bit",
  "lr_scheduler": "linear",
  "warmup_ratio": 0.03,
  "quantization": "4-bit NF4 (bitsandbytes), double quantisation",
  "response_only_loss": true,
  "response_only_verified": true,
  "asset_train_reference_strategy": "first_reference_per_source",
  "asset_train_reference_index": 0,
  "enable_thinking": false,
  "add_special_tokens": false,
  "inference": {
    "max_new_tokens": 256,
    "do_sample": false,
    "decoding": "greedy",
    "repetition_penalty": 1.1,
    "use_cache": true,
    "batch_size": 1
  }
}